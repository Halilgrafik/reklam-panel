# Bu dosya bir ORNEKTIR. Gercek degerleri buraya degil, kendi .env dosyana
# (yerelde) veya GitHub Secrets'a (Actions icin) gir. .env asla commit edilmez.

# --- Meta (Facebook/Instagram) Marketing API ---
META_AD_ACCOUNT_ID_1=act_XXXXXXXXXXXX
META_ACCESS_TOKEN_1=

# --- Google Ads API ---
# Bir Google Cloud OAuth client + developer token TUM hesaplar icin ortaktir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
# Her hesabin kendi customer_id ve refresh_token'i olur.
GOOGLE_CUSTOMER_ID_1=
GOOGLE_LOGIN_CUSTOMER_ID_1=
GOOGLE_REFRESH_TOKEN_1=
